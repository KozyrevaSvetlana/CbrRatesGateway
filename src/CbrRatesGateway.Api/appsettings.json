{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379,abortConnect=false,connectTimeout=2000,syncTimeout=1000"
  },
  "Cbr": {
    "BaseUrl": "https://www.cbr.ru/",
    "DailyRatesPath": "scripts/XML_daily.asp",
    "UserAgent": "CbrRatesGateway/1.0"
  },
  "RatesCache": {
    "KeyPrefix": "cbr-gateway:rates:",
    "FinalRatesTtl": "7.00:00:00",
    "PendingRatesTtl": "00:15:00"
  },
  "Swagger": {
    "Enabled": false
  }
}
